{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Database": "Server=mysql;Port=3306;Database=transaction_db;User=txuser;Password=txpassword;Pooling=true;MinimumPoolSize=1;MaximumPoolSize=30;ConnectionTimeout=15;"
  },
  "Kafka": {
    "BootstrapServers": "redpanda:9092",
    "PollIntervalSeconds": 10,
    "ConsumerBatchSize": 50,
    "ConsumerWindowSeconds": 5
  },
  "MockData": {
    "IntervalSeconds": 5,
    "BatchSize": 5
  },
  "AllowedHosts": "*",
  "Urls": "http://+:8080"
}
